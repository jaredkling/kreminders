# Sample environment for local development.
# There is no automatic .env loading: source it yourself before `go run`.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# `.env` is gitignored; this file is not. Real deployments get their values
# from the systemd unit and secret files (see docs/ops.md §4).

# Required. Used to build absolute links in notifications.
KREM_BASE_URL=http://127.0.0.1:5736

# Bind address and database file for development.
KREM_LISTEN=127.0.0.1:5736
KREM_DB=./kreminders.db

# Schedule defaults.
KREM_TZ=America/Chicago
KREM_DEFAULT_TIME=08:00
KREM_QUIET_HOURS=21:30-08:00
KREM_LOG_LEVEL=debug

# Leave the Gotify URL empty to use the log-only sender.
KREM_GOTIFY_URL=

# Secrets. Required: signing key, 32 bytes hex (`openssl rand -hex 32`).
# In production, prefer the *_FILE variants (KREM_SIGNING_KEY_FILE, ...).
KREM_SIGNING_KEY=

# Optional: enables the confirmation link cleanup in Gotify.
KREM_GOTIFY_APP_TOKEN=
KREM_GOTIFY_CLIENT_TOKEN=

# Optional: leave empty to disable /mcp entirely.
KREM_MCP_TOKEN=
